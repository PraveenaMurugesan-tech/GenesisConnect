# ==============================================================================
# GenesisConnect - Root Environment Configuration Template
# ==============================================================================

# Backend API Configuration
PROJECT_NAME="GenesisConnect API"
ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=genesisconnect
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/genesisconnect

# JWT Authentication
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Setup
FIRST_SUPERADMIN_EMAIL=admin@genesispower.in
FIRST_SUPERADMIN_PASSWORD=change_this_super_admin_secret_123

# Supabase Storage Configuration (Phase 8)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_STORAGE_BUCKET_PRODUCT_DOCS=product-datasheets
SUPABASE_STORAGE_BUCKET_REQUIREMENTS=requirement-documents
PRODUCT_IMAGE_MAX_SIZE_MB=5
DATASHEET_MAX_SIZE_MB=10
ENQUIRY_DOCUMENT_MAX_SIZE_MB=10

# Transactional Email Notification Configuration (Phase 8)
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=Genesis Power Equipments <no-reply@genesispower.in>
ADMIN_NOTIFICATION_EMAIL=sales@genesispower.in
EMAIL_API_KEY=your_transactional_email_provider_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true

# Security & Abuse Protection (Phase 8)
ENABLE_SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=15

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

