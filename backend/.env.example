# ==============================================================================
# GenesisConnect Backend — Environment Configuration Template
# Phase 4: Production-Oriented Backend Foundation
# ==============================================================================

# Application Settings
PROJECT_NAME="GenesisConnect API"
APP_ENV=development
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
API_V1_STR=/api/v1
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# CORS & Networking
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesisconnect

# JWT Authentication (Phase 5+)
SECRET_KEY=e839e99a81f879cf1b70d440adbb847e113a3721344da0c0a3793740e7cbda4e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin (Phase 5+)
FIRST_SUPERADMIN_EMAIL=admin@genesispower.in
FIRST_SUPERADMIN_PASSWORD=AdminSecurePassword123!

# Supabase Storage & Object Storage (Phase 8)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_STORAGE_BUCKET_PRODUCT_DOCS=product-datasheets
SUPABASE_STORAGE_BUCKET_REQUIREMENTS=requirement-documents
PRODUCT_IMAGE_MAX_SIZE_MB=5
DATASHEET_MAX_SIZE_MB=10
ENQUIRY_DOCUMENT_MAX_SIZE_MB=10

# Transactional Email Notification Configuration (Phase 8)
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=Genesis Power Equipments <no-reply@genesispower.in>
ADMIN_NOTIFICATION_EMAIL=sales@genesispower.in
EMAIL_API_KEY=your_transactional_email_provider_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true

# Security & Abuse Protection (Phase 8)
ENABLE_SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=15

